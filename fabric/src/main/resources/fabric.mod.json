{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "accessWidener": "${mod_id}.classtweaker",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://github.com/evanbones/Reliable-Advancements",
    "sources": "https://github.com/evanbones/Reliable-Advancements"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.evandev.reliable_advancements.ReliableAdvancements"
    ],
    "client": [
      "com.evandev.reliable_advancements.client.ReliableAdvancementsClient"
    ],
    "modmenu": [
      "com.evandev.reliable_advancements.config.ReliableAdvancementsModMenu"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=26.1 <=26.2",
    "java": ">=${java_version}",
    "cloth-config": "*"
  }
}