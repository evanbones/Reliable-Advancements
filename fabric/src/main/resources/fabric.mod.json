{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "accessWidener": "${mod_id}.accesswidener",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://github.com/evanbones/Reliable-Advancements",
    "sources": "https://github.com/evanbones/Reliable-Advancements"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.evandev.reliable_advancements.ReliableAdvancements"
    ],
    "client": [
      "com.evandev.reliable_advancements.client.ReliableAdvancementsClient"
    ],
    "modmenu": [
      "com.evandev.reliable_advancements.config.ReliableAdvancementsModMenu"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "cloth-config": "*"
  }
}